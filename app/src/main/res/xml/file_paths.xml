<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internal cache directory (for temporary files like PDFs, images) -->
    <cache-path
        name="cache"
        path="." />

    <!-- Internal files directory -->
    <files-path
        name="files"
        path="." />

    <!-- External files directory scoped to your app (e.g., Documents/, Pictures/) -->
    <external-files-path
        name="ext_files"
        path="." />

</paths>
