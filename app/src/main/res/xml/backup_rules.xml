<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (unused at minSdk 31, kept for completeness). Mirrors data_extraction_rules.xml. -->
<full-backup-content>
    <!-- Encrypted with a device-bound Keystore key: unreadable on any other device. -->
    <exclude domain="database" path="." />
    <!-- Temporary copies of uploaded documents. -->
    <exclude domain="file" path="scans/" />
    <!-- Sync bookkeeping that must stay consistent with the excluded database. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
